# ---- サイト ----
SITE_NAME=播州めだか
AUCTION_NAME=播州オク
BASE_URL=http://localhost:3000
# 管理者として扱うメールアドレス（カンマ区切り）。このアドレスでログインすると出品できます。
ADMIN_EMAILS=owner@example.com

# ---- データベース（SQLite ファイルの場所）----
DATABASE_PATH=./data/auction.sqlite

# ---- 認証 ----
# 認証コードのハッシュ用ソルト。本番では必ずランダムな文字列に変更してください。
OTP_SALT=change-me-to-a-long-random-string

# ---- メール送信（未設定の場合はサーバーログにコードを出力し、画面にも表示します）----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=播州オク <no-reply@example.com>

# ---- LINE Messaging API（未設定なら LINE 通知はログ出力のみ）----
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_ADD_FRIEND_URL=https://lin.ee/xxxxxxx
# LINEログイン（LINEログインチャネル）。設定すると「LINEでログイン」とワンタップ連携が有効
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=

# ---- オークションのルール ----
AUTO_EXTEND_SECONDS=300
AUTO_EXTEND_WINDOW_SECONDS=300
# サドンデス時の最短延長秒数と、新規出品のサドンデス初期値
MIN_EXTEND_SECONDS=60
SUDDEN_DEATH_DEFAULT=true
# 会員承認制（false にすると登録だけで入札できる）
REQUIRE_APPROVAL=true
DEFAULT_BID_INCREMENT=100

# ---- 出品者 ----
# 手数料プラン（名前:率%）
FEE_PLANS=self:10,support:30,full:50
# 画像アップロードの保存先（既定は ./data/uploads）
# UPLOAD_DIR=

# ---- 会員ランク（累計落札額の下限:名前）と二次販売証明の発行料 ----
RANKS=0:見習い,10000:常連,50000:上客,200000:名人
SECONDARY_CERT_FEE=0
# ガチャの「はずれ」の重み（景品の重みと比較して当選確率が決まる）
GACHA_MISS_WEIGHT=70

# ---- 支払い ----
PAYMENT_METHOD=銀行振込
PAYMENT_BANK_INFO=振込先：○○銀行 ○○支店 普通 1234567 ハンシュウメダカ
PAYMENT_DUE_DAYS=3

# ---- 特定商取引法に基づく表記 ----
LEGAL_BUSINESS_NAME=播州めだか
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_SHIPPING_FEE=落札価格に加え、配送地域別の送料を実費でご負担いただきます。

# ---- 終了処理用エンドポイントの保護（任意）----
# CRON_SECRET=
